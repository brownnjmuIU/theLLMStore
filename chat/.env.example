# Copy to .env and fill in. .env is gitignored; this template is not.
# In production these are set in the Render dashboard, NOT in a file.

# Any OpenAI-compatible endpoint. Swapping providers should only change these
# three values plus a redeploy.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Google AI Studio -> Get API key. Never commit the real value.
LLM_API_KEY=your-key-here

# Verified against ai.google.dev on 2026-09-07. gemini-3.8-flash is current but
# was released 2026-09-02; a slightly older model is the safer demo pick while
# free-tier limits on the newest one settle.
LLM_MODEL=gemini-3.5-flash
