{
  "name": "ppllm-studio-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser port of LLM Bundler — runs the full extract/clean/chunk/encrypt pipeline client-side. No server, no upload.",
  "scripts": {
    "dev": "vite",
    "build": "npm run vendor:tesseract && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "vendor:tesseract": "node scripts/vendor-tesseract.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
